# Скелет переменных окружения. Скопировать в .env и заполнить значениями.
# .env в гите нет (см. .gitignore). Здесь — только имена ключей, без значений.
# Новый ключ добавляется сюда одновременно с кодом, который его читает.

# ─────────────────────────────────────────────────────────────────────────────
# LLM: оркестратор (Claude Agent SDK)
# ─────────────────────────────────────────────────────────────────────────────
# Два режима из плана: разработка по подписке, а все eval-прогоны и cost-цифры
# для README — по API. Переключение между режимами делается именно здесь.
#
# Порядок разрешения кредов в Anthropic SDK и Claude Agent SDK (побеждает первый):
#   ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> профиль из ANTHROPIC_PROFILE
#   -> активный профиль на диске (после `ant auth login`)
#
# ВНИМАНИЕ: пустое значение тоже побеждает. Строка `ANTHROPIC_API_KEY=` в .env
# перебьёт подписочный профиль и уйдёт в API с пустым ключом. Чтобы работать по
# подписке, ключ должен быть ЗАКОММЕНТИРОВАН, а не оставлен пустым.

# Режим API (замеры, eval-прогоны, cost в README) — раскомментировать:
# ANTHROPIC_API_KEY=

# Режим подписки (обычная разработка): ключ выше закомментирован, креды берутся
# из профиля `ant auth login`. Имя указывать, только если профилей несколько:
# ANTHROPIC_PROFILE=

# ─────────────────────────────────────────────────────────────────────────────
# LLM: судьи и модель подтверждения (tool B)
# ─────────────────────────────────────────────────────────────────────────────
# От Claude Agent SDK не зависят — обычные вызовы API, провайдер свободен.
# Решение отложено до этапов 6-7; ключи добавить, когда провайдер выбран.
# JUDGE_MODEL=
# CONFIRMATION_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Langfuse — трейсы, токены, cost
# ─────────────────────────────────────────────────────────────────────────────
# На старте cloud; при переезде на self-hosted меняется только LANGFUSE_HOST.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────────────────────
# MLflow — метрики eval-прогонов
# ─────────────────────────────────────────────────────────────────────────────
# На старте локальный бэкенд: sqlite + папка артефактов (оба в .gitignore).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlruns
MLFLOW_EXPERIMENT_NAME=crossmarket

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant — две коллекции (ВБ, Озон)
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Локальному инстансу в докере ключ не нужен — оставить пустым.
QDRANT_API_KEY=
QDRANT_COLLECTION_WB=wb_products
QDRANT_COLLECTION_OZON=ozon_products

# ─────────────────────────────────────────────────────────────────────────────
# ClickHouse — цены и атрибуты обеих площадок (снапшот)
# ─────────────────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=crossmarket

# ─────────────────────────────────────────────────────────────────────────────
# Приложение
# ─────────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Stop-condition оркестратора: оба лимита детерминированные (см. план).
# Точные значения подбираются на этапе 2 при проверке SDK.
AGENT_MAX_TOOL_TURNS=6
AGENT_MAX_BUDGET_USD=

# Путь к локальным данным (в гите нет).
DATA_DIR=./data
